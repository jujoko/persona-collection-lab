# Local ports
PORT=7860
ML_PORT=8788
ML_SERVER=http://127.0.0.1:8788

# Model weights
HF_MODEL_REPO=jujoko/persona-collection-lab-models
# Required only while the model repository is private
HF_TOKEN=
# Phase 1 is experimental; keep disabled for the public game deployment.
REQUIRE_PLAY_MODEL=0

# Public API protection
MAX_REQUEST_BYTES=262144
MAX_TEXT_LENGTH=4000
API_RATE_LIMIT=60

# Database: use the service-role key only in server-side secrets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REQUIRE_SUPABASE=1
REQUIRE_SERVICE_ROLE=1

# Protects GET /api/export
EXPORT_TOKEN=

# Optional M2 narration/decision server
INFER_ENDPOINT=
